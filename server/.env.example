# Gemini API Key (needed for Gemini models)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Default model for Codex/OpenAI provider (e.g., gpt-4o-mini, gpt-3.5-turbo)
BRIDGE_MODEL=gpt-4o-mini

# Default model for Gemini provider (e.g., gemini-pro, gemini-1.5-flash)
GEMINI_MODEL=gemini-pro

# BRIDGE_MODEL=auto

# Tick interval (ms)
TICK_INTERVAL_MS=10000

# Sliding windows (ms)
# Fresh summary considers only the last FRESH_MS (default 20s)
# Context window provides additional 60s lookback for decisions/actions
FRESH_MS=20000
WINDOW_MS=60000

# Allow CORS for local dev web app
ALLOWED_ORIGIN=http://localhost:5173

# CLI bridge runner (Codex Agent Bridge)
# The server will spawn this command and send {model,messages,temperature} JSON on stdin,
# expecting the assistant text on stdout.
BRIDGE_RUN_CMD=node
BRIDGE_RUN_ARGS=scripts/bridge-cli.mjs

# ASR (tab/system audio) — optional
# Provide path to whisper.cpp binary and ffmpeg
# Example: WHISPER_BIN=C:\\tools\\whisper.cpp\\main.exe
WHISPER_BIN=
FFMPEG_BIN=ffmpeg
